{
  "name": "@mixpeek/fhir",
  "version": "1.0.0",
  "type": "module",
  "description": "Mixpeek FHIR Connector - Enrich FHIR R4 clinical resources with multimodal AI-powered content analysis including medical coding suggestions, document classification, and semantic search",
  "main": "dist/index.js",
  "module": "src/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testMatch='**/tests/unit/**/*.test.js'",
    "test:live": "MIXPEEK_API_KEY=$MIXPEEK_API_KEY node --experimental-vm-modules node_modules/jest/bin/jest.js --testMatch='**/tests/live/**/*.test.js'",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "fhir",
    "hl7",
    "healthcare",
    "ehr",
    "clinical",
    "medical",
    "interoperability",
    "r4",
    "mixpeek",
    "ai",
    "multimodal",
    "enrichment",
    "contextual",
    "nlp"
  ],
  "author": "Mixpeek",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mixpeek/connectors.git",
    "directory": "fhir"
  },
  "homepage": "https://github.com/mixpeek/connectors/tree/main/fhir#readme",
  "bugs": {
    "url": "https://github.com/mixpeek/connectors/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "jest": "^29.0.0",
    "eslint": "^8.0.0"
  },
  "peerDependencies": {},
  "dependencies": {}
}
